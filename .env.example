# Copy to .env.local (dev) or /etc/site-attendance.env (server) and fill in.

# REQUIRED in production: random string, 32+ characters.  Generate: openssl rand -hex 32
AUTH_SECRET=

# Database.
#   Empty  → built-in embedded database (PGlite) stored in PGLITE_DIR. No database server needed.
#   Set    → PostgreSQL, e.g. postgres://site:password@127.0.0.1:5432/site_attendance
DATABASE_URL=
PGLITE_DIR=/var/lib/site-attendance/pglite

# Selfies and group photos.
#   Self-hosted: a folder on the server disk.
STORAGE_DIR=/var/lib/site-attendance/files
#   Vercel (no writable disk): create a Blob store and this token is added automatically.
#   When set, photos and the logo go to Blob storage instead of STORAGE_DIR.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private        # set to public only if your plan has no private blobs

# Vercel only: migrations run in the build step (vercel-build), so keep runtime migrations off.
# AUTO_MIGRATE=0

# Password for the first ADMIN user (used only when the database is empty).
ADMIN_PASSWORD=

# 1 = load demo projects/users/punches into an EMPTY database. Keep 0 for a real client.
SEED_DEMO=0

# Secret for the daily photo cleanup cron (POST /api/cron/cleanup).
CRON_SECRET=

# Name shown when the app is installed on a phone.
NEXT_PUBLIC_APP_NAME="JNT Site Attendance"

# Map tiles (admin screens). Default is OpenStreetMap — free, but meant for light use.
# For heavy use or satellite view, use a provider with a free key, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/hybrid/256/{z}/{x}/{y}.jpg?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# Only for testing a production build over plain http (never on a real server).
# COOKIE_SECURE=0
