{
  "name": "site-attendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:reset-password": "tsx scripts/reset-password.ts",
    "icons": "node scripts/gen-icons.mjs --mark public/brand/jnt-mark.svg --small-mark public/brand/jnt-monogram.svg --from \"#E4470C\" --to \"#F29A1A\"",
    "vercel-build": "tsx scripts/migrate.ts && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
